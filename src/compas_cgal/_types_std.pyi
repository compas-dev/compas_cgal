from collections.abc import Iterable
from collections.abc import Iterator
from typing import Self
from typing import overload

import numpy as np
from numpy.typing import NDArray

class _MutableVector[T]:
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[T]: ...
    @overload
    def __getitem__(self, key: int) -> T: ...
    @overload
    def __getitem__(self, key: slice) -> Self: ...
    @overload
    def __setitem__(self, key: int, value: T) -> None: ...
    @overload
    def __setitem__(self, key: slice, value: Iterable[T]) -> None: ...
    def __delitem__(self, key: int | slice) -> None: ...
    def __contains__(self, value: object) -> bool: ...
    def __reversed__(self) -> Iterator[T]: ...
    def append(self, value: T) -> None: ...
    def clear(self) -> None: ...
    def count(self, value: T) -> int: ...
    def extend(self, values: Iterable[T]) -> None: ...
    def insert(self, index: int, value: T) -> None: ...
    def pop(self, index: int = -1) -> T: ...
    def remove(self, value: T) -> None: ...

class VectorDouble(_MutableVector[float]):
    def __init__(self, value: Iterable[float] = ()) -> None: ...

class VectorInt(_MutableVector[int]):
    def __init__(self, value: Iterable[int] = ()) -> None: ...

class VectorVectorInt(_MutableVector[VectorInt]):
    def __init__(self, value: Iterable[Iterable[int]] = ()) -> None: ...

class VectorRowMatrixXd(_MutableVector[NDArray[np.float64]]):
    def __init__(self, value: Iterable[NDArray[np.float64]] = ()) -> None: ...

class VectorRowMatrixXi(_MutableVector[NDArray[np.int32]]):
    def __init__(self, value: Iterable[NDArray[np.int32]] = ()) -> None: ...

class VectorVectorRowMatrixXd(_MutableVector[VectorRowMatrixXd]):
    def __init__(self, value: Iterable[Iterable[NDArray[np.float64]]] = ()) -> None: ...

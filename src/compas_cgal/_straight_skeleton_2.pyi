from collections.abc import Sequence

import numpy as np
from numpy.typing import NDArray

FloatArray = NDArray[np.float64]
IntArray = NDArray[np.int32]
Skeleton = tuple[FloatArray, IntArray, IntArray, IntArray]
PolygonWithHoles = tuple[FloatArray, list[FloatArray]]

def create_interior_straight_skeleton(vertices: FloatArray) -> Skeleton: ...
def create_interior_straight_skeleton_with_holes(boundary_vertices: FloatArray, hole_vertices: Sequence[FloatArray]) -> Skeleton: ...
def create_offset_polygons_2_inner(vertices: FloatArray, offset_distance: float) -> list[FloatArray]: ...
def create_offset_polygons_2_inner_with_holes(boundary_vertices: FloatArray, hole_vertices: Sequence[FloatArray], offset_distance: float) -> list[list[FloatArray]]: ...
def create_offset_polygons_2_outer(vertices: FloatArray, offset_distance: float) -> list[FloatArray]: ...
def create_offset_polygons_2_outer_with_holes(boundary_vertices: FloatArray, hole_vertices: Sequence[FloatArray], offset_distance: float) -> list[list[FloatArray]]: ...
def create_weighted_offset_polygons_2_inner(vertices: FloatArray, offset_distance: float, edge_weights: FloatArray) -> list[FloatArray]: ...
def create_weighted_offset_polygons_2_outer(vertices: FloatArray, offset_distance: float, edge_weights: FloatArray) -> list[FloatArray]: ...
def extrude_straight_skeleton(
    boundary_vertices: FloatArray,
    hole_vertices: Sequence[FloatArray],
    speeds: list[list[float]],
    use_angles: bool,
    maximum_height: float,
) -> tuple[FloatArray, IntArray]: ...

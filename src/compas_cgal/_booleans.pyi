from collections.abc import Sequence

import numpy as np
from numpy.typing import NDArray

FloatArray = NDArray[np.float64]
IntArray = NDArray[np.int32]
Mesh = tuple[FloatArray, IntArray]
MeshWithExtra = tuple[FloatArray, IntArray, IntArray]

def boolean_union(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> Mesh: ...
def boolean_difference(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> Mesh: ...
def boolean_intersection(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> Mesh: ...
def split(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> Mesh: ...
def boolean_union_with_edges(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> MeshWithExtra: ...
def boolean_difference_with_edges(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> MeshWithExtra: ...
def boolean_intersection_with_edges(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> MeshWithExtra: ...
def boolean_union_with_face_source(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> MeshWithExtra: ...
def boolean_difference_with_face_source(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> MeshWithExtra: ...
def boolean_intersection_with_face_source(VA: FloatArray, FA: IntArray, VB: FloatArray, FB: IntArray) -> MeshWithExtra: ...
def boolean_chain(vertices: FloatArray, faces: IntArray, mesh_v_counts: Sequence[int], mesh_f_counts: Sequence[int], operations: Sequence[int]) -> Mesh: ...
def boolean_chain_with_face_source(
    vertices: FloatArray, faces: IntArray, mesh_v_counts: Sequence[int], mesh_f_counts: Sequence[int], operations: Sequence[int]
) -> MeshWithExtra: ...
def boolean_chain_hybrid(vertices: FloatArray, faces: IntArray, mesh_v_counts: Sequence[int], mesh_f_counts: Sequence[int], operations: Sequence[int]) -> Mesh: ...
def boolean_chain_with_face_source_hybrid(
    vertices: FloatArray, faces: IntArray, mesh_v_counts: Sequence[int], mesh_f_counts: Sequence[int], operations: Sequence[int]
) -> MeshWithExtra: ...

from collections.abc import Sequence

import numpy as np
from numpy.typing import NDArray

from ._types_std import VectorRowMatrixXd
from ._types_std import VectorRowMatrixXi

FloatArray = NDArray[np.float64]
IntArray = NDArray[np.int32]
Mesh = tuple[FloatArray, IntArray]

def heat_geodesic_distances(vertices: FloatArray, faces: IntArray, sources: Sequence[int]) -> FloatArray: ...
def geodesic_isolines_split(vertices: FloatArray, faces: IntArray, sources: Sequence[int], isovalues: Sequence[float]) -> tuple[VectorRowMatrixXd, VectorRowMatrixXi]: ...
def geodesic_isolines(vertices: FloatArray, faces: IntArray, sources: Sequence[int], isovalues: Sequence[float]) -> VectorRowMatrixXd: ...
def exact_geodesic_distances(vertices: FloatArray, faces: IntArray, sources: Sequence[int]) -> tuple[FloatArray, IntArray]: ...
def exact_geodesic_distances_from_points(vertices: FloatArray, faces: IntArray, points: FloatArray) -> tuple[FloatArray, IntArray]: ...

class HeatGeodesicSolver:
    def __init__(self, vertices: FloatArray, faces: IntArray) -> None: ...
    @property
    def num_vertices(self) -> int: ...
    def solve(self, sources: Sequence[int]) -> FloatArray: ...

class ExactGeodesicSolver:
    def __init__(self, vertices: FloatArray, faces: IntArray) -> None: ...
    @property
    def num_vertices(self) -> int: ...
    def solve(self, sources: Sequence[int]) -> tuple[FloatArray, IntArray]: ...
    def solve_from_points(self, points: FloatArray) -> tuple[FloatArray, IntArray]: ...
